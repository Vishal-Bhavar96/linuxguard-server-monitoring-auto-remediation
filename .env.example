# LinuxGuard Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-linuxguard-super-secret-key-change-in-production-2026!
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite if DB_ENGINE is sqlite3)
DB_ENGINE=sqlite3
DB_NAME=linuxguard.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Monitoring Configuration
MONITORING_INTERVAL_SECONDS=30
CPU_WARNING_THRESHOLD=85
CPU_CRITICAL_THRESHOLD=95
RAM_WARNING_THRESHOLD=85
RAM_CRITICAL_THRESHOLD=95
DISK_WARNING_THRESHOLD=80
DISK_CRITICAL_THRESHOLD=90
SSH_FAILURE_LIMIT=5
SSH_WINDOW_MINUTES=10
AUTO_REMEDIATE_SAFE_SERVICES=True
